# ==========================================================================
#  .htaccess — tempotravellergoa.in  (static HTML maintenance page)
#  Apache 2.4 / LiteSpeed — safe for shared hosting
#
#  This is the CONSERVATIVE build: every directive known to throw 403/500
#  on shared hosts has been removed. Keeps full hotlink + hacker protection.
# ==========================================================================


# ==========================================================================
#  1. DEFAULT DOCUMENT
# ==========================================================================
DirectoryIndex index.html index.htm


# ==========================================================================
#  2. DISABLE DIRECTORY BROWSING + HIDE SERVER INFO
# ==========================================================================
Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always unset X-AspNet-Version
</IfModule>


# ==========================================================================
#  3. FORCE HTTPS + non-www  (tempotravellergoa.in)
# ==========================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://tempotravellergoa.in%{REQUEST_URI} [R=301,L]

  # Force non-www  (swap this block if you prefer www)
  RewriteCond %{HTTP_HOST} ^www\.tempotravellergoa\.in$ [NC]
  RewriteRule ^ https://tempotravellergoa.in%{REQUEST_URI} [R=301,L]
</IfModule>


# ==========================================================================
#  4. SECURITY HEADERS
# ==========================================================================
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always set X-XSS-Protection "1; mode=block"

  # HSTS — only after HTTPS is confirmed working
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # CSP tuned for this page: inline <style>/<script> + Google Fonts + <canvas>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>


# ==========================================================================
#  5. BLOCK SENSITIVE FILES
#     Most important: your .git folder, since you deploy from a repo.
# ==========================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Blocks .git, .env, .htaccess, .DS_Store and every other dotfile
  RewriteRule "(^|/)\." - [F,L]
</IfModule>

<FilesMatch "(?i)\.(bak|backup|old|orig|save|swp|swo|tmp|log|sql|sqlite|db|ini|conf|env|yml|yaml|sh|bash|py|pl|cgi|lock|dist|inc)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>


# ==========================================================================
#  6. NO SERVER-SIDE EXECUTION
#     Pure HTML site — if an attacker uploads a PHP shell, it can't run.
# ==========================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule \.(php|phtml|php[0-9]|pl|py|cgi|rb|asp|aspx|jsp|sh|exe)$ - [F,L]
</IfModule>


# ==========================================================================
#  7. BLOCK MALICIOUS QUERY STRINGS  (SQLi / XSS / LFI / traversal)
# ==========================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{QUERY_STRING} (\.\./|\.\.%2f|%00) [NC,OR]
  RewriteCond %{QUERY_STRING} (https?|ftp|php|data|file|expect):// [NC,OR]
  RewriteCond %{QUERY_STRING} (union[\s+]+select|select[\s+]+from|insert[\s+]+into|drop[\s+]+table|information_schema|benchmark\s*\(|sleep\s*\() [NC,OR]
  RewriteCond %{QUERY_STRING} (<|%3C)\s*script|javascript:|onerror\s*= [NC,OR]
  RewriteCond %{QUERY_STRING} (base64_decode|eval\s*\(|system\s*\(|shell_exec|phpinfo) [NC]
  RewriteRule ^ - [F,L]
</IfModule>


# ==========================================================================
#  8. BLOCK BAD BOTS, SCANNERS & SITE-RIPPERS
#     Uses mod_rewrite (not Require) — far more compatible on shared hosts.
#     Google / Bing / social preview bots are deliberately NOT blocked.
# ==========================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hacking & vulnerability scanners
  RewriteCond %{HTTP_USER_AGENT} (nikto|sqlmap|havij|acunetix|nessus|openvas|w3af|metasploit|nmap|masscan|zgrab|zmeu|dirbuster|gobuster|wpscan|joomscan|arachni|fimap|hydra) [NC,OR]

  # Site rippers / offline downloaders (bandwidth killers)
  RewriteCond %{HTTP_USER_AGENT} (httrack|webcopier|webzip|teleport|offline\sexplorer|webstripper|websucker|sitesnagger|superbot|extractor|grabber|harvest|collector|siphon|leech|emailsiphon|emailwolf) [NC,OR]

  # SEO crawlers that burn bandwidth with zero benefit to you
  RewriteCond %{HTTP_USER_AGENT} (ahrefsbot|semrushbot|mj12bot|dotbot|megaindex|blexbot|seokicks|sistrix|serpstatbot|dataforseobot|petalbot|barkrowler|zoominfobot|linkdexbot|spbot|magpie-crawler|screaming\sfrog) [NC]

  RewriteRule ^ - [F,L]
</IfModule>


# ==========================================================================
#  9. HOTLINK / BANDWIDTH-THEFT PROTECTION
#     Stops other sites embedding your images so YOU pay for THEIR traffic.
# ==========================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Allow direct visits / bookmarks (no referer)
  RewriteCond %{HTTP_REFERER} !^$

  # Allow your own domain
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?tempotravellergoa\.in [NC]

  # Allow local development
  RewriteCond %{HTTP_REFERER} !^https?://(localhost|127\.0\.0\.1) [NC]

  # Allow search engines
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?(google|bing|yahoo|duckduckgo|yandex|baidu)\. [NC]

  # Allow social platforms so link previews keep working
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?(facebook|fb|instagram|twitter|x|t|linkedin|pinterest|reddit|whatsapp|telegram|slack|medium)\. [NC]

  RewriteRule \.(jpe?g|png|gif|webp|avif|bmp|svg|ico|mp4|webm|mp3|pdf|zip|rar|woff2?|ttf|otf)$ - [F,NC,L]
</IfModule>


# ==========================================================================
#  10. COMPRESSION — biggest bandwidth saver (this HTML shrinks ~75%)
# ==========================================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml image/svg+xml

  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|rar|gz|mp[34]|mp4|pdf|woff2?)$ no-gzip dont-vary

  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding
  </IfModule>
</IfModule>


# ==========================================================================
#  11. BROWSER CACHING
# ==========================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 month"

  # HTML not cached, so maintenance-page edits go live instantly
  ExpiresByType text/html               "access plus 0 seconds"

  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>


# ==========================================================================
#  12. CHARSET + MIME TYPES
# ==========================================================================
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType image/svg+xml   .svg
  AddType image/webp      .webp
  AddType image/avif      .avif
  AddType font/woff2      .woff2
  AddType image/x-icon    .ico
</IfModule>


# ==========================================================================
#  13. ERROR PAGES
#      NOTE: no ErrorDocument 403 here — pointing 403 at a page that is
#      itself being blocked is a classic cause of unexplained 403 loops.
# ==========================================================================
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html


# ==========================================================================
#  14. OPTIONAL: TRUE MAINTENANCE MODE (recommended while the site is down)
#      Returns HTTP 503 + Retry-After so Google treats it as temporary
#      and does NOT de-index tempotravellergoa.in.
#
#      To enable: uncomment, and put YOUR IP in the first line
#      (find it at https://ifconfig.me) so you can still browse the site.
# ==========================================================================
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{REMOTE_ADDR} !^203\.0\.113\.45$
#   RewriteCond %{REQUEST_URI} !^/index\.html$
#   RewriteCond %{REQUEST_URI} !\.(css|js|jpe?g|png|gif|webp|svg|ico|woff2?)$
#   RewriteRule ^ /index.html [R=503,L]
# </IfModule>
# ErrorDocument 503 /index.html
# <IfModule mod_headers.c>
#   Header always set Retry-After "86400"
# </IfModule>
